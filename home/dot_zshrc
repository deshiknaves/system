for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $brew_bin ]] && eval "$($brew_bin shellenv)" && break
done

source ~/.aliases
[[ -f ~/.envvars ]] && source ~/.envvars

eval "$(sheldon source)"

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

[[ -d $HOMEBREW_PREFIX/opt/openjdk/bin ]] && export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"
[[ -d $HOMEBREW_PREFIX/opt/postgresql@17/bin ]] && export PATH="$HOMEBREW_PREFIX/opt/postgresql@17/bin:$PATH"

command -v fnm &>/dev/null && eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"

eval "$(zoxide init --cmd cd zsh)"

[[ -f ~/.vite-plus/env ]] && source ~/.vite-plus/env

eval "$(starship init zsh)"

[[ -f ~/.local_extensions ]] && source ~/.local_extensions
