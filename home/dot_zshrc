for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $brew_bin ]] && eval "$($brew_bin shellenv)" && break
done

source ~/.aliases
[[ -f ~/.envvars ]] && source ~/.envvars

eval "$(sheldon source)"

# macOS /etc/zshrc sets history; Linux leaves HISTFILE unset and nothing is kept.
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_REDUCE_BLANKS

# After sheldon: the vi-mode plugin resets the keymap.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
for keymap in viins emacs; do
  bindkey -M $keymap '^[[A' up-line-or-beginning-search
  bindkey -M $keymap '^[OA' up-line-or-beginning-search
  bindkey -M $keymap '^[[B' down-line-or-beginning-search
  bindkey -M $keymap '^[OB' down-line-or-beginning-search
done

# vi-mode switches on Esc after 0.4s by default
KEYTIMEOUT=1

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

[[ -d $HOMEBREW_PREFIX/opt/openjdk/bin ]] && export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"
[[ -d $HOMEBREW_PREFIX/opt/postgresql@17/bin ]] && export PATH="$HOMEBREW_PREFIX/opt/postgresql@17/bin:$PATH"

command -v fnm &>/dev/null && eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"

eval "$(zoxide init --cmd cd zsh)"

[[ -f ~/.vite-plus/env ]] && source ~/.vite-plus/env

eval "$(starship init zsh)"

[[ -f ~/.local_extensions ]] && source ~/.local_extensions
