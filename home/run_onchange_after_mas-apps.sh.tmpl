#! /bin/bash
set -e
{{ if eq .chezmoi.os "darwin" }}
APPS=(
{{- range list "all" .chezmoi.os (get . "machine") }}
{{- range dig . "mas" (list) $.packages }}
  {{ printf "%v|%s" .id .name | quote }}
{{- end }}
{{- end }}
)

load_brew() {
  local brew_bin
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      return
    fi
  done
}

# Stops at the first failure, since mas 7 cannot check sign-in directly.
install_mas_apps() {
  [ "${#APPS[@]}" -gt 0 ] || return 0

  echo "🔍 Checking for mas..."
  command -v mas &>/dev/null || load_brew
  if ! command -v mas &>/dev/null; then
    echo "⚠ mas not found, skipping App Store apps"
    return
  fi

  local installed entry id name
  installed="$(mas list)"
  for entry in "${APPS[@]}"; do
    id="${entry%%|*}"
    name="${entry#*|}"
    if grep -Eq "^[[:space:]]*${id}[[:space:]]" <<<"$installed"; then
      echo "✅ $name found"
      continue
    fi
    echo "⏳ Installing $name"
    if ! mas install "$id"; then
      echo "⚠ App Store install failed, likely not signed in. Sign in, then run: just mas"
      return
    fi
  done
}

install_mas_apps
{{- end }}
