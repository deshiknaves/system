#!/bin/bash

set -e

echo "🔍 Checking for Homebrew..."
if ! command -v brew &>/dev/null; then
  for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
fi

if ! command -v brew &>/dev/null; then
  echo "❌ Homebrew not found"
  exit 1
fi
echo "✅ Homebrew found"

echo "⏳ Installing packages"
if brew bundle --file=- <<'BREWFILE'; then
{{- $darwin := eq .chezmoi.os "darwin" }}
{{- $groups := list "all" .chezmoi.os (get . "machine") }}
{{- range $groups }}
{{- range dig . "brews" (list) $.packages }}
brew {{ . | quote }}
{{- end }}
{{- end }}
{{- if $darwin }}
{{- range $groups }}
{{- range dig . "casks" (list) $.packages }}
cask {{ . | quote }}
{{- end }}
{{- end }}
{{- range $groups }}
{{- range dig . "mas" (list) $.packages }}
mas {{ .name | quote }}, id: {{ .id }}
{{- end }}
{{- end }}
{{- end }}
BREWFILE
  echo "✅ Packages installed"
else
  echo "❌ Package install failed"
  exit 1
fi
